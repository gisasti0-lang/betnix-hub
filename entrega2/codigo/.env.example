# Copiá a .env y completá. .env NO se versiona.
# API de Telegram: https://my.telegram.org -> API development tools
# (Las credenciales viejas quedaron expuestas en un repo público: rotarlas.)
export BETNIX_TG_API_ID="<nuevo_api_id>"
export BETNIX_TG_API_HASH="<nuevo_api_hash>"

# PAT de GitHub, scope `repo`, solo para publicar resumen.json
export BETNIX_GH_TOKEN="<nuevo_pat>"
